{
  "name": "@hris/web",
  "version": "0.1.0",
  "private": true,
  "description": "Enterprise HRIS web application (Next.js App Router)",
  "license": "UNLICENSED",
  "scripts": {
    "build": "next build",
    "clean": "rm -rf .next coverage node_modules/.cache",
    "dev": "next dev --port ${WEB_PORT:-3000}",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prebuild": "npm run build --if-present -w @hris/shared-types -w @hris/config",
    "predev": "npm run build --if-present -w @hris/shared-types -w @hris/config",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@hris/config": "*",
    "@hris/shared-types": "*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.51.0",
    "next": "^15.2.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@hris/eslint-config": "*",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.15.3",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^26.0.0",
    "postcss": "^8.4.31",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.1"
  }
}

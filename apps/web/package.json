{
  "name": "@hris/web",
  "version": "0.1.0",
  "private": true,
  "description": "Enterprise HRIS web application (Next.js App Router)",
  "license": "UNLICENSED",
  "scripts": {
    "build": "next build",
    "clean": "rm -rf .next coverage node_modules/.cache",
    "dev": "next dev --port ${WEB_PORT:-3000}",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prebuild": "npm run build --if-present -w @hris/shared-types -w @hris/config -w @hris/ui",
    "predev": "npm run build --if-present -w @hris/shared-types -w @hris/config -w @hris/ui",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hris/config": "*",
    "@hris/shared-types": "*",
    "@hris/ui": "*",
    "next": "^15.2.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@hris/eslint-config": "*",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.15.3",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^26.0.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.1"
  }
}

{
  "name": "@hris/worker",
  "version": "0.1.0",
  "private": true,
  "description": "Enterprise HRIS background worker (email delivery and provider calls)",
  "license": "UNLICENSED",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist coverage",
    "dev": "ts-node --transpile-only src/main.ts",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,test}/**/*.ts\" --fix",
    "start": "node dist/main.js",
    "test": "jest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hris/database": "*",
    "@hris/shared-types": "*",
    "bullmq": "^5.34.10",
    "ioredis": "^5.6.1",
    "nodemailer": "^10.1.0"
  },
  "devDependencies": {
    "@hris/eslint-config": "*",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.3",
    "@types/nodemailer": "^8.0.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.3.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}

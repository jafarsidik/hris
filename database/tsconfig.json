{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": ["ES2023"],
    "rootDir": ".",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": false,
    "sourceMap": true,
    "types": ["node", "jest"],
    "noUncheckedIndexedAccess": false
  },
  "include": [
    "src/**/*.ts",
    "tests/**/*.ts",
    "seeds/**/*.ts",
    "scripts/**/*.ts",
    "prisma.config.ts"
  ],
  "exclude": ["node_modules", "dist"]
}

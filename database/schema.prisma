generator client {
  provider = "prisma-client"
  output   = "src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Countries the platform is offered in. Seeded from `COUNTRY_CODES`.
model Country {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String   @unique @db.Citext
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy String?  @map("created_by_user_id") @db.Uuid
  users     User?    @relation(fields: [createdBy], references: [id], map: "countries_created_by_fkey")

  @@map("countries")
}

/// Currencies and their minor-unit exponents, so amounts can be stored exactly.
model Currency {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String   @unique @db.Citext
  name      String
  /// Decimal places: 2 for USD, 0 for JPY, 3 for KWD.
  minorUnit Int      @map("minor_unit")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy String?  @map("created_by_user_id") @db.Uuid
  users     User?    @relation(fields: [createdBy], references: [id], map: "currencies_created_by_fkey")

  @@map("currencies")
}

/// Platform roles. Provisioned from `SYSTEM_ROLES` by the seed script.
model Role {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String           @unique
  name        String
  description String
  isSystem    Boolean          @default(false) @map("is_system")
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy   String?          @map("created_by_user_id") @db.Uuid
  grants      RolePermission[]
  users       UserRole[]

  @@map("roles")
}

/// A single `resource.action` capability.
///
/// `resource` is a string column rather than an enum because the RBAC vocabulary
/// contains `industrial-relation`, and a hyphen is not a legal Prisma enum value.
/// A `CHECK` constraint is deliberately not used either: it would have to be
/// rewritten by hand every time a module is added. Instead a drift-guard test
/// asserts the seeded rows match `RESOURCES` from @hris/shared-types exactly.
model Permission {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key       String           @unique
  resource  String
  action    Action
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy String?          @map("created_by_user_id") @db.Uuid
  users     User?            @relation(fields: [createdBy], references: [id], map: "permissions_created_by_fkey")
  roles     RolePermission[]

  @@unique([resource, action])
  @@index([resource])
  @@map("permissions")
}

/// A capability granted to a role, together with the scope it applies within.
model RolePermission {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  dataScope    DataScope  @default(SELF) @map("data_scope")
  /// Narrows the grant to one organizational subtree, e.g. a single department.
  scopeId      String?    @map("scope_id") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy    String?    @map("created_by_user_id") @db.Uuid
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId, dataScope], map: "role_permissions_role_permission_scope_key")
  @@index([permissionId])
  @@map("role_permissions")
}

/// A legal employer. The root of the tenant hierarchy.
model Company {
  id                                        String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                                      String               @unique @db.Citext
  name                                      String
  status                                    String               @default("ACTIVE")
  plan                                      String               @default("STANDARD")
  suspendedAt                               DateTime?            @map("suspended_at") @db.Timestamptz(3)
  trialEndsAt                               DateTime?            @map("trial_ends_at") @db.Timestamptz(3)
  seatLimit                                 Int?                 @map("seat_limit")
  storageQuotaBytes                          BigInt?              @map("storage_quota_bytes")
  createdAt                                 DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                                 DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy                                 String?              @map("created_by_user_id") @db.Uuid
  deletedAt                                 DateTime?            @map("deleted_at") @db.Timestamptz(3)
  users_companies_created_by_user_idTousers User?                @relation("companies_created_by_user_idTousers", fields: [createdBy], references: [id], map: "companies_created_by_fkey")
  entities                                  Entity[]
  units                                     OrganizationalUnit[]
  users                                     User[]
  positions                                 Position[]
  employees                                 Employee[]
  leaveTypes                                LeaveType[]
  leavePolicies                             LeavePolicy[]
  leaveRequests                             LeaveRequest[]
  attendanceRecords                         AttendanceRecord[]
  shiftPatterns                             ShiftPattern[]
  payrollPeriods                            PayrollPeriod[]
  salaryStructures                          SalaryStructure[]
  payrollRuns                               PayrollRun[]
  payrollComponents                         PayrollComponent[]
  jobRequisitions                           JobRequisition[]
  jobCandidates                             JobCandidate[]
  jobApplications                           JobApplication[]
  performanceCycles                         PerformanceCycle[]
  performanceGoals                          PerformanceGoal[]
  performanceReviews                        PerformanceReview[]
  offboardingCases                          OffboardingCase[]
  offboardingChecklistItems                 OffboardingChecklistItem[]
  employeeContacts                          EmployeeContact[]
  employeeFamily                            EmployeeFamilyMember[]
  employeeEducation                         EmployeeEducation[]
  employeeExperience                        EmployeeExperience[]
  employeeSkills                            EmployeeSkill[]
  employeeCertifications                    EmployeeCertification[]
  employeeDocuments                         EmployeeDocument[]
  employmentContracts                       EmploymentContract[]
  employeeMovements                         EmployeeMovement[]
  workLocations                             WorkLocation[]

  @@index([name])
  @@map("companies")
}

/// A statutory or operational unit of a company: the payroll or legal entity that
/// owns employees and pays them.
model Entity {
  id           String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId    String               @map("company_id") @db.Uuid
  code         String               @db.Citext
  name         String
  countryCode  String               @map("country_code") @db.Citext
  currencyCode String               @map("currency_code") @db.Citext
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy    String?              @map("created_by_user_id") @db.Uuid
  deletedAt    DateTime?            @map("deleted_at") @db.Timestamptz(3)
  company      Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  users        User?                @relation(fields: [createdBy], references: [id], map: "entities_created_by_fkey")
  units        OrganizationalUnit[]

  @@unique([companyId, code])
  @@index([companyId])
  @@map("entities")
}

/// A node of the division → department → section → team hierarchy.
///
/// `companyId` is denormalised from the owning entity on purpose. A row-level
/// security policy cannot traverse a join, so without a company column on the
/// table the only way to filter units by tenant would be application code — which
/// is exactly the single layer DATABASE.md says must not be the only one.
model OrganizationalUnit {
  id                                                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId                                            String                 @map("company_id") @db.Uuid
  entityId                                             String?                @map("entity_id") @db.Uuid
  parentId                                             String?                @map("parent_id") @db.Uuid
  type                                                 OrganizationalUnitType
  code                                                 String                 @db.Citext
  name                                                 String
  createdAt                                            DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                                            DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy                                            String?                @map("created_by_user_id") @db.Uuid
  deletedAt                                            DateTime?              @map("deleted_at") @db.Timestamptz(3)
  company                                              Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  users_organizational_units_created_by_user_idTousers User?                  @relation("organizational_units_created_by_user_idTousers", fields: [createdBy], references: [id], map: "organizational_units_created_by_fkey")
  entity                                               Entity?                @relation(fields: [entityId], references: [id])
  parent                                               OrganizationalUnit?    @relation("UnitHierarchy", fields: [parentId], references: [id])
  children                                             OrganizationalUnit[]   @relation("UnitHierarchy")
  users                                                User[]
  positions                                            Position[]
  employees                                            Employee[]

  @@unique([companyId, code])
  @@index([companyId, parentId])
  @@index([entityId])
  @@map("organizational_units")
}

/// A human who can sign in. Employee records live in a later phase; a user is an
/// identity, which is a different concern from employment.
model User {
  id                                                                          String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId                                                                   String                   @map("company_id") @db.Uuid
  email                                                                       String                   @unique @db.Citext
  displayName                                                                 String                   @map("display_name")
  status                                                                      UserStatus               @default(INVITED)
  passwordHash                                                                String?                  @map("password_hash")
  hasVerifiedEmail                                                            Boolean                  @default(false) @map("has_verified_email")
  lastLoginAt                                                                 DateTime?                @map("last_login_at") @db.Timestamptz(3)
  createdAt                                                                   DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                                                                   DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy                                                                   String?                  @map("created_by_user_id") @db.Uuid
  deletedAt                                                                   DateTime?                @map("deleted_at") @db.Timestamptz(3)
  /// SHA-256 of the opaque email-verification token (ADR 0010 hash convention).
  emailVerificationTokenHash                                                  String?                  @unique @map("email_verification_token_hash")
  /// Consecutive failed sign-in attempts, reset on a successful sign-in.
  failedAttempts                                                              Int                      @default(0) @map("failed_attempts")
  /// When set, sign-in attempts are refused until this instant (account lockout).
  lockedUntil                                                                 DateTime?                @map("locked_until") @db.Timestamptz(3)
  passwordChangedAt                                                           DateTime?                @map("password_changed_at") @db.Timestamptz(3)
  passwordResetExpiresAt                                                      DateTime?                @map("password_reset_expires_at") @db.Timestamptz(3)
  /// SHA-256 of the opaque password-reset token (ADR 0010 hash convention).
  passwordResetTokenHash                                                      String?                  @unique @map("password_reset_token_hash")
  /// The organizational unit the user sits in. This is what makes TEAM,
  /// DEPARTMENT and ENTITY data scopes resolvable: a scope narrows a query to the
  /// subtree (or entity) rooted at the unit the caller belongs to.
  organizationalUnitId                                                        String?                  @map("organizational_unit_id") @db.Uuid
  app_modules                                                                 AppModule[]
  applications                                                                Application[]
  approval_authorities                                                        ApprovalAuthority[]
  approval_delegations                                                        ApprovalDelegation[]
  audit_logs                                                                  AuditLog[]
  authenticators_authenticators_created_by_user_idTousers                     Authenticator[]          @relation("authenticators_created_by_user_idTousers")
  authenticators_authenticators_user_idTousers                                Authenticator[]          @relation("authenticators_user_idTousers")
  companies_companies_created_by_user_idTousers                               Company[]                @relation("companies_created_by_user_idTousers")
  countries                                                                   Country[]
  currencies                                                                  Currency[]
  entities                                                                    Entity[]
  identity_providers                                                          IdentityProvider[]
  log_events                                                                  LogEvent[]
  mfa_factors_mfa_factors_created_by_user_idTousers                           MfaFactor[]              @relation("mfa_factors_created_by_user_idTousers")
  mfa_factors_mfa_factors_user_idTousers                                      MfaFactor[]              @relation("mfa_factors_user_idTousers")
  mfa_recovery_codes_mfa_recovery_codes_created_by_user_idTousers             MfaRecoveryCode[]        @relation("mfa_recovery_codes_created_by_user_idTousers")
  mfa_recovery_codes_mfa_recovery_codes_user_idTousers                        MfaRecoveryCode[]        @relation("mfa_recovery_codes_user_idTousers")
  notification_preferences_notification_preferences_created_by_user_idTousers NotificationPreference[] @relation("notification_preferences_created_by_user_idTousers")
  notification_preferences_notification_preferences_user_idTousers            NotificationPreference[] @relation("notification_preferences_user_idTousers")
  notification_templates                                                      NotificationTemplate[]
  notifications_notifications_created_by_user_idTousers                       Notification[]           @relation("notifications_created_by_user_idTousers")
  notifications_notifications_user_idTousers                                  Notification[]           @relation("notifications_user_idTousers")
  organizational_units_organizational_units_created_by_user_idTousers         OrganizationalUnit[]     @relation("organizational_units_created_by_user_idTousers")
  permissions                                                                 Permission[]
  registered_actions                                                          RegisteredAction[]
  resource_definitions                                                        ResourceDefinition[]
  resource_fields                                                             ResourceField[]
  sessions_sessions_created_by_user_idTousers                                 Session[]                @relation("sessions_created_by_user_idTousers")
  sessions                                                                    Session[]
  sso_identities_sso_identities_created_by_user_idTousers                     SsoIdentity[]            @relation("sso_identities_created_by_user_idTousers")
  sso_identities_sso_identities_user_idTousers                                SsoIdentity[]            @relation("sso_identities_user_idTousers")
  system_settings                                                             SystemSetting[]
  user_roles_user_roles_created_by_user_idTousers                             UserRole[]               @relation("user_roles_created_by_user_idTousers")
  roles                                                                       UserRole[]
  groupMemberships UserGroupMember[]
  company                                                                     Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  users                                                                       User?                    @relation("usersTousers", fields: [createdBy], references: [id], map: "users_created_by_fkey")
  other_users                                                                 User[]                   @relation("usersTousers")
  unit                                                                        OrganizationalUnit?      @relation(fields: [organizationalUnitId], references: [id])
  accessReviewItems AccessReviewItem[]
  employee              Employee[]           @relation("user_employee")

  @@index([companyId])
  @@index([status])
  @@index([organizationalUnitId])
  @@map("users")
}

/// A role granted to a user.
///
/// A null `companyId` is a platform-wide grant. Any other value scopes the grant to
/// a single company, which is how one administrator can hold roles in two companies
/// without those grants leaking into a third.
model UserRole {
  id                                         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                                     String   @map("user_id") @db.Uuid
  roleId                                     String   @map("role_id") @db.Uuid
  companyId                                  String?  @map("company_id") @db.Uuid
  createdAt                                  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                                  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy                                  String?  @map("created_by_user_id") @db.Uuid
  users_user_roles_created_by_user_idTousers User?    @relation("user_roles_created_by_user_idTousers", fields: [createdBy], references: [id], map: "user_roles_created_by_fkey")
  role                                       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user                                       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, companyId])
  @@index([roleId])
  @@index([companyId])
  @@map("user_roles")
}

/// Durable metadata for a sign-in.
///
/// The session token itself is an opaque random value stored in Redis with a short
/// TTL (ADR 0006). Only the record of the session lives here, so that access can be
/// reviewed and revoked after the token has expired.
model Session {
  id                                       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                                   String    @map("user_id") @db.Uuid
  companyId                                String    @map("company_id") @db.Uuid
  /// SHA-256 of the opaque token, so a database disclosure does not yield usable tokens.
  tokenHash                                String    @unique @map("token_hash")
  userAgent                                String?   @map("user_agent")
  ipAddress                                String?   @map("ip_address") @db.Inet
  lastSeenAt                               DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  expiresAt                                DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt                                DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt                                DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                                DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy                                String?   @map("created_by_user_id") @db.Uuid
  deletedAt                                DateTime? @map("deleted_at") @db.Timestamptz(3)
  users_sessions_created_by_user_idTousers User?     @relation("sessions_created_by_user_idTousers", fields: [createdBy], references: [id], map: "sessions_created_by_fkey")
  user                                     User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([companyId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Append-only audit trail.
///
/// This table is deliberately exempt from two conventions above: it has no
/// `updated_at` and no `deleted_at`. `DATABASE.md` requires audit logs to keep the
/// row and the action, so allowing either would permit history to be rewritten.
///
/// `entryHash` chains each record to the previous one within the company, so a
/// deleted or edited row is detectable. That is a detective control; the append-only
/// trigger in the migration is the preventive one.
model AuditLog {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId    String   @map("company_id") @db.Uuid
  actorUserId  String?  @map("actor_user_id") @db.Uuid
  action       String
  resource     String
  resourceId   String?  @map("resource_id")
  /// Identity is pseudonymised rather than erased, so the row survives erasure requests.
  payload      Json?
  previousHash String?  @map("previous_hash")
  entryHash    String   @unique @map("entry_hash")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy    String?  @map("created_by_user_id") @db.Uuid
  users        User?    @relation(fields: [createdBy], references: [id], map: "audit_logs_created_by_fkey")

  @@index([companyId, createdAt(sort: Desc)])
  @@index([resource, resourceId])
  @@map("audit_logs")
}

/// Structured, append-only event log feeding the Logs surface.
///
/// Unlike `audit_logs` this is not hash-chained: it holds the operational
/// categories (activity, access, authentication, security, API, error) whose
/// records are high-volume and never compared against each other for tampering.
/// Like `audit_logs` it is append-only — no `updated_at`, no `deleted_at` — and the
/// migration installs a trigger refusing UPDATE, DELETE and TRUNCATE.
model LogEvent {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   String      @map("company_id") @db.Uuid
  category    LogCategory
  eventType   String      @map("event_type")
  actorUserId String?     @map("actor_user_id") @db.Uuid
  resource    String?
  resourceId  String?     @map("resource_id")
  /// Machine-readable result, e.g. `SUCCESS`, `FAILED`, `DENIED`, `PENDING`.
  status      String?
  metadata    Json?
  ipAddress   String?     @map("ip_address") @db.Inet
  userAgent   String?     @map("user_agent")
  requestId   String?     @map("request_id")
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy   String?     @map("created_by_user_id") @db.Uuid
  users       User?       @relation(fields: [createdBy], references: [id], map: "log_events_created_by_fkey")

  @@index([companyId, createdAt(sort: Desc)])
  @@index([category, createdAt(sort: Desc)])
  @@index([actorUserId, createdAt(sort: Desc)])
  @@index([resource, resourceId])
  @@map("log_events")
}

/// A company-scoped configuration value for the System Settings surface.
///
/// `value` is stored as JSON so that types beyond strings (numbers, booleans,
/// arrays) survive a round trip. `is_sensitive` marks values such as SMTP
/// passwords or API keys whose stored value must be masked on read and shown as
/// redacted in audit output.
model SystemSetting {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   String           @map("company_id") @db.Uuid
  group       String           @map("group")
  key         String
  value       Json?
  valueType   SettingValueType @map("value_type")
  isSensitive Boolean          @default(false) @map("is_sensitive")
  isEditable  Boolean          @default(true) @map("is_editable")
  description String?
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy   String?          @map("created_by_user_id") @db.Uuid
  users       User?            @relation(fields: [createdBy], references: [id], map: "system_settings_created_by_fkey")

  @@unique([companyId, group, key])
  @@index([companyId, group])
  @@map("system_settings")
}

/// One delivered notification for one recipient.
///
/// Deliberately append-style like `log_events`: no `updated_at` and no
/// `deleted_at`, because the read/unread transition is written in place rather
/// than by rewriting history.
model Notification {
  id                                            String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId                                     String                     @map("company_id") @db.Uuid
  userId                                        String                     @map("user_id") @db.Uuid
  kind                                          NotificationKind
  eventKey                                      String                     @map("event_key")
  title                                         String
  description                                   String
  href                                          String?
  channel                                       NotificationChannel
  deliveryStatus                                NotificationDeliveryStatus @map("delivery_status")
  correlationId                                 String?                    @map("correlation_id")
  readAt                                        DateTime?                  @map("read_at") @db.Timestamptz(3)
  createdAt                                     DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy                                     String?                    @map("created_by_user_id") @db.Uuid
  users_notifications_created_by_user_idTousers User?                      @relation("notifications_created_by_user_idTousers", fields: [createdBy], references: [id], map: "notifications_created_by_fkey")
  users_notifications_user_idTousers            User                       @relation("notifications_user_idTousers", fields: [userId], references: [id], onDelete: Cascade, map: "notifications_user_fkey")

  @@index([companyId, userId, createdAt(sort: Desc)], map: "notifications_company_user_created_idx")
  @@index([companyId, deliveryStatus], map: "notifications_company_status_idx")
  @@map("notifications")
}

/// A recipient's per-channel delivery toggle. A row missing for a channel means
/// the API falls back to the company setting for that channel.
model NotificationPreference {
  id                                                       String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId                                                String              @map("company_id") @db.Uuid
  userId                                                   String              @map("user_id") @db.Uuid
  channel                                                  NotificationChannel
  enabled                                                  Boolean             @default(true)
  createdAt                                                DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                                                DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy                                                String?             @map("created_by_user_id") @db.Uuid
  deletedAt                                                DateTime?           @map("deleted_at") @db.Timestamptz(3)
  users_notification_preferences_created_by_user_idTousers User?               @relation("notification_preferences_created_by_user_idTousers", fields: [createdBy], references: [id], map: "notification_preferences_created_by_fkey")
  users_notification_preferences_user_idTousers            User                @relation("notification_preferences_user_idTousers", fields: [userId], references: [id], onDelete: Cascade, map: "notification_preferences_user_fkey")

  @@unique([companyId, userId, channel], map: "notification_preferences_company_user_channel_key")
  @@index([userId])
  @@map("notification_preferences")
}

/// A per-event, per-channel message template rendered when an event is emitted.
model NotificationTemplate {
  id              String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId       String              @map("company_id") @db.Uuid
  eventKey        String              @map("event_key")
  channel         NotificationChannel
  subjectTemplate String              @map("subject_template")
  bodyTemplate    String              @map("body_template")
  enabled         Boolean             @default(true)
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy       String?             @map("created_by_user_id") @db.Uuid
  deletedAt       DateTime?           @map("deleted_at") @db.Timestamptz(3)
  users           User?               @relation(fields: [createdBy], references: [id], map: "notification_templates_created_by_fkey")

  @@unique([companyId, eventKey, channel], map: "notification_templates_company_event_channel_key")
  @@map("notification_templates")
}

/// An enrolled second factor (currently TOTP). The seed is encrypted at rest.
model MfaFactor {
  id                                          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId                                   String        @map("company_id") @db.Uuid
  userId                                      String        @map("user_id") @db.Uuid
  type                                        MfaFactorType
  secretEncrypted                             String        @map("secret_encrypted")
  label                                       String        @default("Default authenticator")
  confirmedAt                                 DateTime?     @map("confirmed_at") @db.Timestamptz(3)
  lastUsedAt                                  DateTime?     @map("last_used_at") @db.Timestamptz(3)
  createdAt                                   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                                   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy                                   String?       @map("created_by_user_id") @db.Uuid
  deletedAt                                   DateTime?     @map("deleted_at") @db.Timestamptz(3)
  users_mfa_factors_created_by_user_idTousers User?         @relation("mfa_factors_created_by_user_idTousers", fields: [createdBy], references: [id], map: "mfa_factors_created_by_fkey")
  users_mfa_factors_user_idTousers            User          @relation("mfa_factors_user_idTousers", fields: [userId], references: [id], onDelete: Cascade, map: "mfa_factors_user_fkey")

  @@index([companyId, userId], map: "mfa_factors_company_user_idx")
  @@map("mfa_factors")
}

/// A one-time recovery code (SHA-256 hash of the plain code).
model MfaRecoveryCode {
  id                                                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId                                          String    @map("company_id") @db.Uuid
  userId                                             String    @map("user_id") @db.Uuid
  codeHash                                           String    @map("code_hash")
  usedAt                                             DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt                                          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                                          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy                                          String?   @map("created_by_user_id") @db.Uuid
  deletedAt                                          DateTime? @map("deleted_at") @db.Timestamptz(3)
  users_mfa_recovery_codes_created_by_user_idTousers User?     @relation("mfa_recovery_codes_created_by_user_idTousers", fields: [createdBy], references: [id], map: "mfa_recovery_codes_created_by_fkey")
  users_mfa_recovery_codes_user_idTousers            User      @relation("mfa_recovery_codes_user_idTousers", fields: [userId], references: [id], onDelete: Cascade, map: "mfa_recovery_codes_user_fkey")

  @@index([companyId, userId], map: "mfa_recovery_codes_company_user_idx")
  @@index([codeHash])
  @@map("mfa_recovery_codes")
}

/// An identity provider a tenant signs in through (OIDC or SAML).
///
/// Per-protocol credentials and metadata live in `config` as JSON so the schema
/// does not have to grow for protocol-specific fields; sensitive members
/// (client secrets, signing keys) are encrypted before storage and decrypted
/// only when the flow needs them.
model IdentityProvider {
  id        String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String               @map("company_id") @db.Uuid
  name      String
  type      IdentityProviderType
  enabled   Boolean              @default(true)
  domains   Json?                @map("domains")
  config    Json?                @map("config")
  createdAt DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy String?              @map("created_by_user_id") @db.Uuid
  deletedAt DateTime?            @map("deleted_at") @db.Timestamptz(3)
  users     User?                @relation(fields: [createdBy], references: [id], map: "identity_providers_created_by_fkey")

  @@index([companyId, enabled], map: "identity_providers_company_enabled_idx")
  @@map("identity_providers")
}

/// The mapping between an identity-provider subject and a local user.
model SsoIdentity {
  id                                             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId                                      String    @map("company_id") @db.Uuid
  userId                                         String    @map("user_id") @db.Uuid
  providerId                                     String    @map("provider_id") @db.Uuid
  subject                                        String
  email                                          String?   @db.Citext
  createdAt                                      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                                      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy                                      String?   @map("created_by_user_id") @db.Uuid
  deletedAt                                      DateTime? @map("deleted_at") @db.Timestamptz(3)
  users_sso_identities_created_by_user_idTousers User?     @relation("sso_identities_created_by_user_idTousers", fields: [createdBy], references: [id], map: "sso_identities_created_by_fkey")
  users_sso_identities_user_idTousers            User      @relation("sso_identities_user_idTousers", fields: [userId], references: [id], onDelete: Cascade, map: "sso_identities_user_fkey")

  @@unique([providerId, subject], map: "sso_identities_provider_subject_key")
  @@index([companyId, userId], map: "sso_identities_company_user_idx")
  @@map("sso_identities")
}

/// A WebAuthn passkey registered to a user.
model Authenticator {
  id                                             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId                                      String    @map("company_id") @db.Uuid
  userId                                         String    @map("user_id") @db.Uuid
  credentialId                                   String    @map("credential_id")
  publicKey                                      String    @map("public_key")
  counter                                        BigInt    @default(0)
  transports                                     Json?
  deviceName                                     String?   @map("device_name")
  lastUsedAt                                     DateTime? @map("last_used_at") @db.Timestamptz(3)
  createdAt                                      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                                      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy                                      String?   @map("created_by_user_id") @db.Uuid
  deletedAt                                      DateTime? @map("deleted_at") @db.Timestamptz(3)
  users_authenticators_created_by_user_idTousers User?     @relation("authenticators_created_by_user_idTousers", fields: [createdBy], references: [id], map: "authenticators_created_by_fkey")
  users_authenticators_user_idTousers            User      @relation("authenticators_user_idTousers", fields: [userId], references: [id], onDelete: Cascade, map: "authenticators_user_fkey")

  @@unique([companyId, credentialId], map: "authenticators_company_credential_key")
  @@index([companyId, userId], map: "authenticators_company_user_idx")
  @@map("authenticators")
}

/// An approval authority rule: who may approve what, up to a monetary limit.
model ApprovalAuthority {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId     String              @map("company_id") @db.Uuid
  subjectType   ApprovalSubjectType @map("subject_type")
  subjectId     String              @map("subject_id") @db.Uuid
  resource      String?
  category      String?
  maxAmount     Decimal?            @map("max_amount") @db.Decimal(18, 2)
  currencyCode  String?             @map("currency_code") @db.Citext
  effectiveFrom DateTime?           @map("effective_from") @db.Timestamptz(3)
  effectiveTo   DateTime?           @map("effective_to") @db.Timestamptz(3)
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy     String?             @map("created_by_user_id") @db.Uuid
  deletedAt     DateTime?           @map("deleted_at") @db.Timestamptz(3)
  users         User?               @relation(fields: [createdBy], references: [id], map: "approval_authorities_created_by_fkey")

  @@index([companyId, subjectId], map: "approval_authorities_company_subject_idx")
  @@map("approval_authorities")
}

/// A temporary approval delegation from one user to another.
model ApprovalDelegation {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId       String    @map("company_id") @db.Uuid
  delegatorUserId String    @map("delegator_user_id") @db.Uuid
  delegateeUserId String    @map("delegatee_user_id") @db.Uuid
  resource        String?
  category        String?
  effectiveFrom   DateTime? @map("effective_from") @db.Timestamptz(3)
  effectiveTo     DateTime? @map("effective_to") @db.Timestamptz(3)
  reason          String?
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy       String?   @map("created_by_user_id") @db.Uuid
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(3)
  users           User?     @relation(fields: [createdBy], references: [id], map: "approval_delegations_created_by_fkey")

  @@index([companyId, delegatorUserId], map: "approval_delegations_company_delegator_idx")
  @@map("approval_delegations")
}

/// A named workflow owned by a tenant. Versions hang off it; instances pin a version.
model WorkflowDefinition {
  id          String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   String             @map("company_id") @db.Uuid
  key         String
  name        String
  description String?
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy   String?            @map("created_by_user_id") @db.Uuid
  deletedAt   DateTime?          @map("deleted_at") @db.Timestamptz(3)
  instances   WorkflowInstance[]
  versions    WorkflowVersion[]

  @@unique([companyId, key], map: "workflow_definitions_company_key_key")
  @@map("workflow_definitions")
}

/// A point-in-time definition of a workflow. `states` and `transitions` are JSON and
/// only become runnable once the version is published (`ACTIVE`).
model WorkflowVersion {
  id           String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId    String                @map("company_id") @db.Uuid
  definitionId String                @map("definition_id") @db.Uuid
  version      Int
  status       WorkflowVersionStatus @default(DRAFT)
  states       Json                  @default("[]")
  transitions  Json                  @default("[]")
  steps        Json                  @default("[]")
  publishedAt  DateTime?             @map("published_at") @db.Timestamptz(3)
  createdAt    DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy    String?               @map("created_by_user_id") @db.Uuid
  instances    WorkflowInstance[]
  definition   WorkflowDefinition    @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  @@unique([definitionId, version], map: "workflow_versions_definition_version_key")
  @@map("workflow_versions")
}

/// A running workflow pinned to the version it started on.
model WorkflowInstance {
  id              String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId       String                    @map("company_id") @db.Uuid
  definitionId    String                    @map("definition_id") @db.Uuid
  versionId       String                    @map("version_id") @db.Uuid
  resource        String?
  resourceId      String?                   @map("resource_id")
  currentStateKey String                    @map("current_state_key")
  stepKey         String?                   @map("step_key")
  dueAt           DateTime?                 @map("due_at") @db.Timestamptz(3)
  escalationAt    DateTime?                 @map("escalation_at") @db.Timestamptz(3)
  status          WorkflowInstanceStatus    @default(IN_PROGRESS)
  createdAt       DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy       String?                   @map("created_by_user_id") @db.Uuid
  deletedAt       DateTime?                 @map("deleted_at") @db.Timestamptz(3)
  definition      WorkflowDefinition        @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  version         WorkflowVersion           @relation(fields: [versionId], references: [id], onDelete: Cascade)
  events          WorkflowTransitionEvent[]
  tasks           WorkflowTask[]

  @@index([resource, resourceId], map: "workflow_instances_resource_idx")
  @@index([companyId, definitionId], map: "workflow_instances_company_id_idx")
  @@map("workflow_instances")
}

/// Append-only record of every transition an instance has taken.
model WorkflowTransitionEvent {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId      String           @map("company_id") @db.Uuid
  instanceId     String           @map("instance_id") @db.Uuid
  fromStateKey   String?          @map("from_state_key")
  toStateKey     String           @map("to_state_key")
  transitionName String           @map("transition_name")
  actorUserId    String           @map("actor_user_id") @db.Uuid
  comment        String?
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  instance       WorkflowInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@index([instanceId, createdAt], map: "workflow_transition_events_instance_created_idx")
  @@map("workflow_transition_events")
}

/// A configured external integration (SMTP relay, webhook, storage, ...).
model Integration {
  id               String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId        String                @map("company_id") @db.Uuid
  key              String
  name             String
  kind             IntegrationKind
  provider         String
  config           Json                  @default("{}")
  isEnabled        Boolean               @default(true) @map("is_enabled")
  status           IntegrationStatus     @default(UNKNOWN)
  lastCheckedAt    DateTime?             @map("last_checked_at") @db.Timestamptz(3)
  lastMessage      String?               @map("last_message")
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy        String?               @map("created_by_user_id") @db.Uuid
  deletedAt        DateTime?             @map("deleted_at") @db.Timestamptz(3)
  /// AES-256-GCM envelope of the webhook signing secret; null when none is set.
  secretCiphertext String?               @map("secret_ciphertext")
  deliveries       IntegrationDelivery[]
  subscriptions    WebhookSubscription[]

  @@unique([companyId, key], map: "integrations_company_key_key")
  @@map("integrations")
}

/// Subscribes one webhook integration to one domain event type.
///
/// Kept as rows rather than an array in `config` so the dispatcher's lookup is a join
/// and every event a tenant receives is explicitly opted into. `*` subscribes to all.
model WebhookSubscription {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId     String      @map("company_id") @db.Uuid
  integrationId String      @map("integration_id") @db.Uuid
  eventType     String      @map("event_type")
  isActive      Boolean     @default(true) @map("is_active")
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy     String?     @map("created_by_user_id") @db.Uuid
  integration   Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([integrationId, eventType], map: "webhook_subscriptions_integration_event_key")
  @@map("webhook_subscriptions")
}

/// One recorded integration operation (connection test or delivery attempt).
model IntegrationDelivery {
  id            String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId     String                       @map("company_id") @db.Uuid
  integrationId String                       @map("integration_id") @db.Uuid
  direction     IntegrationDeliveryDirection @default(OUTBOUND)
  operation     String
  status        IntegrationDeliveryStatus
  attempt       Int                          @default(1)
  error         String?
  durationMs    Int?                         @map("duration_ms")
  request       Json?
  response      Json?
  createdAt     DateTime                     @default(now()) @map("created_at") @db.Timestamptz(3)
  integration   Integration                  @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@index([companyId, integrationId, createdAt(sort: Desc)], map: "integration_deliveries_integration_created_idx")
  @@map("integration_deliveries")
}

/// A deployed application on the platform. The HRIS itself is the first one.
model Application {
  id          String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String               @unique
  name        String
  description String?
  isActive    Boolean              @default(true) @map("is_active")
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy   String?              @map("created_by_user_id") @db.Uuid
  modules     AppModule[]
  users       User?                @relation(fields: [createdBy], references: [id], map: "applications_created_by_fkey")
  resources   ResourceDefinition[]

  @@map("applications")
}

/// A module of an application. `moduleId` links to the shared `MODULE_IDS` vocabulary.
model AppModule {
  id            String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  applicationId String               @map("application_id") @db.Uuid
  key           String               @unique
  name          String
  description   String?
  moduleId      String?              @map("module_id")
  isActive      Boolean              @default(true) @map("is_active")
  sortOrder     Int                  @default(0) @map("sort_order")
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy     String?              @map("created_by_user_id") @db.Uuid
  application   Application          @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  users         User?                @relation(fields: [createdBy], references: [id], map: "app_modules_created_by_fkey")
  resources     ResourceDefinition[]

  @@index([applicationId])
  @@map("app_modules")
}

/// A resource a module owns: the unit that permissions and CRUD surfaces attach to.
model ResourceDefinition {
  id            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  applicationId String             @map("application_id") @db.Uuid
  moduleId      String?            @map("module_id") @db.Uuid
  key           String             @unique
  name          String
  description   String?
  resourceType  ResourceType       @map("resource_type")
  supportsCrud  Boolean            @default(false) @map("supports_crud")
  isActive      Boolean            @default(true) @map("is_active")
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy     String?            @map("created_by_user_id") @db.Uuid
  actions       RegisteredAction[]
  application   Application        @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  users         User?              @relation(fields: [createdBy], references: [id], map: "resource_definitions_created_by_fkey")
  module        AppModule?         @relation(fields: [moduleId], references: [id])
  fields        ResourceField[]

  @@index([applicationId])
  @@index([moduleId])
  @@map("resource_definitions")
}

/// A field a registered resource exposes (drives validation and rendering).
model ResourceField {
  id          String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  resourceId  String             @map("resource_id") @db.Uuid
  key         String
  label       String
  dataType    FieldDataType      @map("data_type")
  required    Boolean            @default(false)
  isSensitive Boolean            @default(false) @map("is_sensitive")
  sortOrder   Int                @default(0) @map("sort_order")
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy   String?            @map("created_by_user_id") @db.Uuid
  users       User?              @relation(fields: [createdBy], references: [id], map: "resource_fields_created_by_fkey")
  resource    ResourceDefinition @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([resourceId, key])
  @@map("resource_fields")
}

/// An action a registered resource supports (a standard RBAC action or a custom one).
model RegisteredAction {
  id          String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  resourceId  String             @map("resource_id") @db.Uuid
  action      String
  name        String
  description String?
  isCustom    Boolean            @default(false) @map("is_custom")
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy   String?            @map("created_by_user_id") @db.Uuid
  users       User?              @relation(fields: [createdBy], references: [id], map: "registered_actions_created_by_fkey")
  resource    ResourceDefinition @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([resourceId, action])
  @@map("registered_actions")
}

/// A row of a generic, registry-declared resource (`supportsCrud`).
///
/// A resource registered at runtime has no dedicated table, so the platform stores the
/// validated field values as JSON keyed by the resource key. `ownerUserId` and
/// `organizationalUnitId` are projected into real columns on purpose: SELF and the
/// org-level scopes must remain query predicates the database evaluates, not filters
/// applied in application code after a broader read.
model ResourceRecord {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId            String    @map("company_id") @db.Uuid
  resourceKey          String    @map("resource_key")
  data                 Json
  ownerUserId          String?   @map("owner_user_id") @db.Uuid
  organizationalUnitId String?   @map("organizational_unit_id") @db.Uuid
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy            String?   @map("created_by_user_id") @db.Uuid
  deletedAt            DateTime? @map("deleted_at") @db.Timestamptz(3)

  @@index([companyId, resourceKey], map: "resource_records_company_resource_idx")
  @@index([organizationalUnitId])
  @@map("resource_records")
}

/// A machine credential for the developer API (Phase 4).
///
/// The secret is shown once at creation and stored only as its SHA-256 hash — the
/// secret is high-entropy random, so a fast hash is sufficient and avoids the cost of
/// argon2 on every API request (the same reasoning as opaque session tokens, ADR 0010).
/// `scopes` is a list of `resource.action` keys; an API key can never exceed the
/// permissions of the user it was created by, enforced at creation via `canGrant`.
model ApiClient {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   String    @map("company_id") @db.Uuid
  name        String
  description String?
  /// Public half of the credential, safe to display; the secret is never stored.
  clientId    String    @unique @map("client_id")
  secretHash  String    @map("secret_hash")
  /// Granted `resource.action` pairs, e.g. `user.view`.
  scopes      String[]  @default([])
  ownerUserId String    @map("owner_user_id") @db.Uuid
  isActive    Boolean   @default(true) @map("is_active")
  lastUsedAt  DateTime? @map("last_used_at") @db.Timestamptz(3)

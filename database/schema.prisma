  employees          Employee[]
  salaryStructures   SalaryStructure[]
  jobRequisitions    JobRequisition[]

  @@unique([companyId, code], map: "positions_company_code_unique")
  @@index([companyId], map: "positions_company_idx")
  @@index([organizationalUnit], map: "positions_unit_idx")
  @@map("positions")
}

/// An employment record: the HR-side counterpart of a `User` identity.
///
/// A `User` is who can sign in; an `Employee` is who is employed. They share a
/// tenant but are distinct concerns — a user may exist without an employee record
/// (invited but not yet hired), and the two are linked by `userId`.
model Employee {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId          String   @map("company_id") @db.Uuid
  userId             String   @map("user_id") @db.Uuid
  employeeNumber     String   @map("employee_number")
  organizationalUnit String?  @map("organizational_unit_id") @db.Uuid
  position           String?  @map("position_id") @db.Uuid
  employmentType     String   @map("employment_type")
  status             String   @map("status")
  hireDate           DateTime @map("hire_date") @db.Timestamptz(3)
  terminationDate    DateTime? @map("termination_date") @db.Timestamptz(3)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy          String?  @map("created_by_user_id") @db.Uuid
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz(3)

  company              Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user                 User                   @relation("user_employee", fields: [userId], references: [id], onDelete: Cascade)
  unit                 OrganizationalUnit?  @relation(fields: [organizationalUnit], references: [id])
  jobPosition          Position?              @relation(fields: [position], references: [id])
  leaveRequests        LeaveRequest[]
  attendanceRecords    AttendanceRecord[]
  payrollRuns          PayrollRun[]
  performanceGoals     PerformanceGoal[]
  performanceReviews   PerformanceReview[]
  offboardingCases     OffboardingCase[]
  employeeContacts     EmployeeContact[]
  familyMembers        EmployeeFamilyMember[]
  educationHistory     EmployeeEducation[]
  experienceHistory    EmployeeExperience[]
  skills               EmployeeSkill[]
  certifications       EmployeeCertification[]
  documents            EmployeeDocument[]
  employmentContracts  EmploymentContract[]
  movements            EmployeeMovement[]

  @@unique([companyId, employeeNumber], map: "employees_company_number_unique")
  @@index([companyId], map: "employees_company_idx")
  @@index([userId], map: "employees_user_idx")
  @@index([organizationalUnit], map: "employees_unit_idx")
  @@index([position], map: "employees_position_idx")
  @@map("employees")
}

/// A leave type definition: annual, sick, maternity, paternity, etc.
///
/// Each type carries its default annual entitlement (in days) and whether it is
/// paid. Entitlement policies (`leave_policy`) can override this per company.
model LeaveType {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  code        String   @db.Citext
  name        String
  description String?
  isPaid      Boolean  @default(true) @map("is_paid")
  defaultDays Int      @default(0) @map("default_days")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy   String?  @map("created_by_user_id") @db.Uuid

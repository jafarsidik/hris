// ==============================================================================
// HRIS platform schema — phase 1
//
// Conventions are defined in docs/DATABASE.md and are applied from the first
// migration onward, so they are never retrofitted onto a populated table:
//
//   * Primary keys are uuid generated by the database (`gen_random_uuid()`),
//     never a client-supplied value and never a sequence.
//   * Plural `snake_case` table names, `snake_case` columns. Timestamps end in
//     `_at`, dates in `_date`, booleans read as assertions.
//   * Every instant is `timestamptz`. Timezone names are stored separately
//     where the local wall clock matters.
//   * `citext` for identifiers a human types.
//   * Soft deletion via `deleted_at`.
//   * `created_at`, `updated_at` and `created_by_user_id` on every mutable table.
//
// Tables split into two groups:
//
//   Global   Reference data shared by every tenant (countries, currencies,
//            roles, permissions). No RLS, because they carry no tenant data.
//   Tenant   Everything scoped to a company. Row-level security is enabled and
//            FORCED on these by the initial migration; see the note there.
//
// `created_by_user_id` is deliberately a plain uuid column rather than a Prisma
// relation. Every table would otherwise declare a back-reference to `users`,
// and `companies` ↔ `users` would become a relation cycle. The foreign key is
// still enforced — it is declared in the migration — so the integrity guarantee
// is unchanged; only Prisma's generated navigation helper is absent, and nothing
// needs to traverse it.
// ==============================================================================

generator client {
  provider = "prisma-client"
  output   = "src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Actions a permission can grant. Mirrors `ACTIONS` in @hris/shared-types.
enum Action {
  view
  create
  update
  delete
  approve
  reject
  export
  download
  manage
}

/// Hierarchical scope a permission applies to. Mirrors `DATA_SCOPES`.
enum DataScope {
  SELF
  TEAM
  DEPARTMENT
  ENTITY
  COMPANY
  GLOBAL
}

/// Level within the organizational hierarchy (ARCHITECTURE section 8).
enum OrganizationalUnitType {
  DIVISION
  DEPARTMENT
  SECTION
  TEAM
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DISABLED
}

// ------------------------------------------------------------------------------
// Global reference data
// ------------------------------------------------------------------------------

/// Countries the platform is offered in. Seeded from `COUNTRY_CODES`.
model Country {
  id   String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code String @unique @db.Citext
  name String

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy String?   @map("created_by_user_id") @db.Uuid

  @@map("countries")
}

/// Currencies and their minor-unit exponents, so amounts can be stored exactly.
model Currency {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String  @unique @db.Citext
  name      String
  /// Decimal places: 2 for USD, 0 for JPY, 3 for KWD.
  minorUnit Int     @map("minor_unit")
  isActive  Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy String?   @map("created_by_user_id") @db.Uuid

  @@map("currencies")
}

/// Platform roles. Provisioned from `SYSTEM_ROLES` by the seed script.
model Role {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String  @unique
  name        String
  description String
  isSystem    Boolean @default(false) @map("is_system")

  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy String?         @map("created_by_user_id") @db.Uuid
  grants     RolePermission[]
  users      UserRole[]

  @@map("roles")
}

/// A single `resource.action` capability.
///
/// `resource` is a string column rather than an enum because the RBAC vocabulary
/// contains `industrial-relation`, and a hyphen is not a legal Prisma enum value.
/// A `CHECK` constraint is deliberately not used either: it would have to be
/// rewritten by hand every time a module is added. Instead a drift-guard test
/// asserts the seeded rows match `RESOURCES` from @hris/shared-types exactly.
model Permission {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key      String @unique
  resource String
  action   Action

  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy String?         @map("created_by_user_id") @db.Uuid
  roles     RolePermission[]

  @@unique([resource, action], map: "permissions_resource_action_key")
  @@index([resource], map: "permissions_resource_idx")
  @@map("permissions")
}

/// A capability granted to a role, together with the scope it applies within.
model RolePermission {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roleId       String    @map("role_id") @db.Uuid
  permissionId String    @map("permission_id") @db.Uuid
  dataScope    DataScope @default(SELF) @map("data_scope")
  /// Narrows the grant to one organizational subtree, e.g. a single department.
  scopeId      String?   @map("scope_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy String?  @map("created_by_user_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId, dataScope], map: "role_permissions_role_permission_scope_key")
  @@index([permissionId], map: "role_permissions_permission_id_idx")
  @@map("role_permissions")
}

// ------------------------------------------------------------------------------
// Tenant data
// ------------------------------------------------------------------------------

/// A legal employer. The root of the tenant hierarchy.
model Company {
  id   String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code String @unique @db.Citext
  name String

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy String?   @map("created_by_user_id") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  entities   Entity[]
  units      OrganizationalUnit[]
  users      User[]

  @@index([name], map: "companies_name_idx")
  @@map("companies")
}

/// A statutory or operational unit of a company: the payroll or legal entity that
/// owns employees and pays them.
model Entity {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId  String  @map("company_id") @db.Uuid
  code       String  @db.Citext
  name       String
  countryCode String  @map("country_code") @db.Citext
  currencyCode String @map("currency_code") @db.Citext

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy String?   @map("created_by_user_id") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  company Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  units   OrganizationalUnit[]

  @@unique([companyId, code], map: "entities_company_id_code_key")
  @@index([companyId], map: "entities_company_id_idx")
  @@map("entities")
}

/// A node of the division → department → section → team hierarchy.
///
/// `companyId` is denormalised from the owning entity on purpose. A row-level
/// security policy cannot traverse a join, so without a company column on the
/// table the only way to filter units by tenant would be application code — which
/// is exactly the single layer DATABASE.md says must not be the only one.
model OrganizationalUnit {
  id        String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String                @map("company_id") @db.Uuid
  entityId  String?               @map("entity_id") @db.Uuid
  parentId  String?               @map("parent_id") @db.Uuid
  type      OrganizationalUnitType
  code      String                @db.Citext
  name      String

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy String?   @map("created_by_user_id") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  company Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  entity  Entity?           @relation(fields: [entityId], references: [id], onDelete: SetNull)
  parent  OrganizationalUnit? @relation("UnitHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children OrganizationalUnit[] @relation("UnitHierarchy")

  @@unique([companyId, code], map: "organizational_units_company_id_code_key")
  @@index([companyId, parentId], map: "organizational_units_company_id_parent_id_idx")
  @@index([entityId], map: "organizational_units_entity_id_idx")
  @@map("organizational_units")
}

/// A human who can sign in. Employee records live in a later phase; a user is an
/// identity, which is a different concern from employment.
model User {
  id              String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId       String     @map("company_id") @db.Uuid
  email           String     @unique @db.Citext
  displayName     String     @map("display_name")
  status          UserStatus @default(INVITED)
  passwordHash    String?    @map("password_hash")
  hasVerifiedEmail Boolean   @default(false) @map("has_verified_email")
  lastLoginAt     DateTime?  @map("last_login_at") @db.Timestamptz(3)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy String?   @map("created_by_user_id") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  roles    UserRole[]
  sessions Session[]

  @@index([companyId], map: "users_company_id_idx")
  @@index([status], map: "users_status_idx")
  @@map("users")
}

/// A role granted to a user.
///
/// A null `companyId` is a platform-wide grant. Any other value scopes the grant to
/// a single company, which is how one administrator can hold roles in two companies
/// without those grants leaking into a third.
model UserRole {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String @map("user_id") @db.Uuid
  roleId    String @map("role_id") @db.Uuid
  companyId String? @map("company_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy String?  @map("created_by_user_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, companyId], map: "user_roles_user_id_role_id_company_id_key")
  @@index([roleId], map: "user_roles_role_id_idx")
  @@index([companyId], map: "user_roles_company_id_idx")
  @@map("user_roles")
}

/// Durable metadata for a sign-in.
///
/// The session token itself is an opaque random value stored in Redis with a short
/// TTL (ADR 0006). Only the record of the session lives here, so that access can be
/// reviewed and revoked after the token has expired.
model Session {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  companyId      String    @map("company_id") @db.Uuid
  /// SHA-256 of the opaque token, so a database disclosure does not yield usable tokens.
  tokenHash      String    @unique @map("token_hash")
  userAgent      String?   @map("user_agent")
  ipAddress      String?   @map("ip_address") @db.Inet
  lastSeenAt     DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(3)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy String?   @map("created_by_user_id") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "sessions_user_id_idx")
  @@index([companyId], map: "sessions_company_id_idx")
  @@index([expiresAt], map: "sessions_expires_at_idx")
  @@map("sessions")
}

/// Append-only audit trail.
///
/// This table is deliberately exempt from two conventions above: it has no
/// `updated_at` and no `deleted_at`. `DATABASE.md` requires audit logs to keep the
/// row and the action, so allowing either would permit history to be rewritten.
///
/// `entryHash` chains each record to the previous one within the company, so a
/// deleted or edited row is detectable. That is a detective control; the append-only
/// trigger in the migration is the preventive one.
model AuditLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String
  resource    String
  resourceId  String?  @map("resource_id") @db.Uuid
  /// Identity is pseudonymised rather than erased, so the row survives erasure requests.
  payload     Json?
  previousHash String? @map("previous_hash")
  entryHash    String  @map("entry_hash")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy String?  @map("created_by_user_id") @db.Uuid

  @@unique([entryHash], map: "audit_logs_entry_hash_key")
  @@index([companyId, createdAt(sort: Desc)], map: "audit_logs_company_id_created_at_idx")
  @@index([resource, resourceId], map: "audit_logs_resource_resource_id_idx")
  @@map("audit_logs")
}
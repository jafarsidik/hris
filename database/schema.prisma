/// Lifecycle of a stored object. Mirrors `FILE_OBJECT_STATUSES`.
enum FileObjectStatus {
  PENDING
  AVAILABLE
  DELETED
}

/// A stored object's metadata. The bytes live in S3-compatible storage; this row is the
/// durable record of what was uploaded, who owns it and the retention window.
model FileObject {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId      String           @map("company_id") @db.Uuid
  name           String
  mimeType       String           @map("mime_type")
  size           BigInt?
  storageKey     String           @unique @map("storage_key")
  bucket         String
  checksum       String?
  status         FileObjectStatus @default(PENDING)
  entity         String?
  entityId       String?          @map("entity_id") @db.Uuid
  retentionDays  Int?             @map("retention_days")
  retentionUntil DateTime?        @map("retention_until") @db.Timestamptz(3)
  uploadedBy     String?          @map("uploaded_by_user_id") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  /// When the bytes were removed. Deliberately NOT `deletedAt`: a deleted file must
  /// stay visible (retention sweep, admin view), so it is not a `softDeleteExtension`
  /// model; `status` is the soft-delete marker.
  removedAt      DateTime?        @map("removed_at") @db.Timestamptz(3)

  @@index([companyId, status], map: "files_company_status_idx")
  @@index([companyId, entity, entityId], map: "files_company_entity_idx")
  @@index([status, retentionUntil], map: "files_status_retention_idx")
  @@map("files")
}


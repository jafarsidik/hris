# ==============================================================================
# ENTERPRISE HRIS - ENVIRONMENT TEMPLATE
# ==============================================================================
# Copy to `.env` and adjust for your environment:
#   cp .env.example .env
#
# .env is git-ignored. NEVER commit real credentials, keys, or tokens.
# Production values MUST come from a secret manager, not from this file.
# ==============================================================================

# ------------------------------------------------------------------------------
# Runtime
# ------------------------------------------------------------------------------
NODE_ENV=development
# Interface the API binds. `0.0.0.0` binds all interfaces (dual-stack) and is
# required in containers. `127.0.0.1` restricts it to the local machine for
# development. "localhost" is rejected: it resolves to ::1 and leaves IPv4 clients
# unable to connect.
API_HOST=0.0.0.0
API_PORT=3001
# Comma-separated list of allowed browser origins for the web app.
CORS_ORIGINS=http://localhost:3000

# ------------------------------------------------------------------------------
# Logging
# ------------------------------------------------------------------------------
# One of: error | warn | log | debug | verbose
LOG_LEVEL=debug

# ------------------------------------------------------------------------------
# PostgreSQL
# ------------------------------------------------------------------------------
# Host-side port. The default 5432 and the commonly used 5433/5434 are already
# taken by other local stacks on this machine, so this project publishes 5435.
# Containers always reach PostgreSQL on 5432 via the compose service name.
POSTGRES_HOST=localhost
POSTGRES_PORT=5435
POSTGRES_DB=hris
# Owner/migration role. Owns the tables and applies Prisma migrations. The official
# image creates it as a superuser, so it must never be the role the API connects as.
POSTGRES_USER=hris
# Development-only default. Generate a strong value for any shared environment.
POSTGRES_PASSWORD=hris_dev_password
# Role the running application connects as. It owns nothing and has NOBYPASSRLS, so
# the row-level security policies in the migrations actually apply to it. A
# superuser bypasses RLS unconditionally, which is why this role exists separately.
POSTGRES_APP_USER=hris_app
POSTGRES_APP_PASSWORD=hris_dev_app_password

# ------------------------------------------------------------------------------
# Redis
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
# 6380 is used by another local stack; 6381 keeps this project isolated.
REDIS_PORT=6381
REDIS_PASSWORD=hris_dev_redis
REDIS_DB=0

# ------------------------------------------------------------------------------
# Authentication (Phase 2)
# ------------------------------------------------------------------------------
# Generate with: openssl rand -base64 48
JWT_SECRET=replace_me_min_32_characters_random_secret
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

# ------------------------------------------------------------------------------
# Object storage (Phase 1 / File management)
# ------------------------------------------------------------------------------
# Backed by RustFS (Apache-2.0, S3-compatible). The variable names stay
# provider-neutral on purpose: only the endpoint changes to move to MinIO, Ceph
# or AWS S3, so no application code has to know which one is running.
STORAGE_PORT=9000
STORAGE_CONSOLE_PORT=9001
STORAGE_LOG_LEVEL=info
# Host-side endpoint for tools running outside the compose network. Containers
# must use http://rustfs:9000 instead.
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=hris-documents
# Keep the access key uppercase and alphanumeric. AWS Signature Version 4 embeds
# it in the credential scope, and characters like "/" break signature
# calculation. Generate the secret with: openssl rand -base64 24
STORAGE_ACCESS_KEY=HRISDEVACCESSKEY
STORAGE_SECRET_KEY=replace_me_dev_storage_secret_0123456789

# ------------------------------------------------------------------------------
# Email / SMTP
# ------------------------------------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@hris.local
MAIL_FROM_NAME=HRIS

# ------------------------------------------------------------------------------
# AI providers (Phase 15)
# ------------------------------------------------------------------------------
# AI features are disabled unless AI_ENABLED=true. No key is required while off.
AI_ENABLED=false
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_MS=60000

# ------------------------------------------------------------------------------
# Web / Next.js
# ------------------------------------------------------------------------------
WEB_PORT=3000
# Browser-facing URLs. NEXT_PUBLIC_* values are inlined into the client bundle at
# build time, so they must be reachable from the user's machine and cannot be an
# internal service name such as "api".
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_API_PLATFORM_URL=http://localhost:3001
# Server-side (SSR) URLs, read at runtime. Inside Docker the API is reached over
# the private network by service name; docker-compose.yml sets these to
# http://api:3001. Left unset locally, the NEXT_PUBLIC_ values above are used.
# API_BASE_URL=http://localhost:3001/api/v1
# API_PLATFORM_URL=http://localhost:3001

# ------------------------------------------------------------------------------
# Mobile / Expo
# ------------------------------------------------------------------------------
# EXPO_PUBLIC_* values are inlined into the mobile bundle at build time.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1
EXPO_PUBLIC_API_PLATFORM_URL=http://localhost:3001
